<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted Hermes dashboards commonly run plain http:// on a LAN or tailnet. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
